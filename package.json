{
  "name": "distributed-wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down",
    "test:integration": "LOG_LEVEL=silent bun test ./test/integration --timeout 60000"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@mikro-orm/core": "7.2.3",
    "@mikro-orm/migrations": "7.2.3",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "decimal.js": "^10.6.0",
    "pino": "10",
    "prom-client": "15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
