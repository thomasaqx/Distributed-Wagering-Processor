# Copy to .env and adjust. Defaults match docker-compose.yml for running the API on the host.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering

# Local SQS emulator (MiniStack). Credentials are dummies; the emulator does not validate them.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_WALLET_EVENTS_QUEUE=wallet-events

LOG_LEVEL=info

# Background workers (all enabled by default; tests disable the ones they do not exercise)
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=5
SQS_RETRY_BASE_SECONDS=2
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=10
